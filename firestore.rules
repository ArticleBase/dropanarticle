rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function hasProfile() { return signedIn() && exists(profilePath(request.auth.uid)); }
    function isEditor() {
      return hasProfile() && get(profilePath(request.auth.uid)).data.role in ['editor', 'admin'];
    }
    function isAdmin() {
      return hasProfile() && get(profilePath(request.auth.uid)).data.role == 'admin';
    }

    // Public pages can only read published stories. Editors can manage every article.
    match /articles/{articleId} {
      allow read: if isEditor() || resource.data.status == 'published';
      allow create: if isEditor()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 140
        && request.resource.data.slug is string
        && request.resource.data.slug.size() >= 3
        && request.resource.data.slug.size() <= 140
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 100000
        && request.resource.data.status in ['draft', 'published', 'archived'];
      allow update: if isEditor()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 140
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 100000
        && request.resource.data.status in ['draft', 'published', 'archived'];
      allow delete: if isEditor();
    }

    // Anonymous contributors can only create validated pending submissions.
    // The private queue is readable/modifiable only by approved editors.
    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
          'title','slug','excerpt','content','author','email','website','category',
          'image','imageAlt','metaTitle','metaDescription','tags','date','source','status',
          'reviewed','createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 8
        && request.resource.data.title.size() <= 140
        && request.resource.data.slug is string
        && request.resource.data.slug.size() <= 140
        && request.resource.data.excerpt is string
        && request.resource.data.excerpt.size() >= 30
        && request.resource.data.excerpt.size() <= 500
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 300
        && request.resource.data.content.size() <= 50000
        && request.resource.data.author is string
        && request.resource.data.author.size() > 0
        && request.resource.data.author.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 300
        && (request.resource.data.website == '' || request.resource.data.website.matches('https?://.*'))
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 80
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 700
        && (request.resource.data.image == '' || request.resource.data.image.matches('https?://.*'))
        && request.resource.data.imageAlt is string
        && request.resource.data.imageAlt.size() <= 180
        && request.resource.data.metaTitle is string
        && request.resource.data.metaTitle.size() <= 70
        && request.resource.data.metaDescription is string
        && request.resource.data.metaDescription.size() <= 170
        && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 15
        && request.resource.data.source == 'public-submission'
        && request.resource.data.status == 'pending'
        && request.resource.data.reviewed == false
        && request.resource.data.createdAt == request.time;

      allow read: if isEditor();
      allow update: if isEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','reviewed','editorialNotes','updatedAt','articleId'
        ])
        && request.resource.data.status in ['pending','changes_requested','rejected','published']
        && request.resource.data.reviewed is bool;
      allow delete: if isAdmin();
    }

    // Contact/newsletter submissions. Public users can create, not read or edit.
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','subject','message','createdAt','read'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 180
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 180
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 4000
        && request.resource.data.createdAt == request.time
        && request.resource.data.read == false;
      allow read, update: if isEditor();
      allow delete: if isAdmin();
    }

    // User role records are provisioned by an administrator through the Console or trusted code.
    // Users cannot assign or elevate their own role.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName','email','bio','photoURL','createdAt'])
        && !('role' in request.resource.data));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','photoURL']));
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isEditor();
    }

    match /siteSettings/{settingId} {
      allow read: if settingId == 'public';
      allow write: if isAdmin();
    }

    match /editorialLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isEditor();
      allow update, delete: if isAdmin();
    }
  }
}
