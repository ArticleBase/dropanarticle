rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Articles: anyone can read; only authenticated users can write.
    // For open community publishing, change "request.auth != null" to "true".
    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Contact / newsletter messages: create-only for visitors, read for admins.
    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
